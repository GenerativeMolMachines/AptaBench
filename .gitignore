# ============================================
# Project-specific
# ============================================

# Cached embeddings (large files)
notebooks/data/embeddings/*.npy
notebooks/data/embeddings/*.json
notebooks/data/*.npy

# Model checkpoints (large files)
notebooks/checkpoints/*.db
notebooks/notebooks/checkpoints/*.db
checkpoints/
*.ckpt
*.pth
*.pt
*.h5
*.hdf5

# Optuna databases (can be large)
*.db
!setup.db  # Exclude setup.db if you have one

# Logs
*.log
logs/
notebooks/logs/

# Large data files (uncomment if you don't want to track them)
# data/raw/*
# data/interim/*
# dataset/*.csv
# dataset/*.parquet

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# Hugging Face cache (very large)
.cache/
*.cache/
transformers_cache/

# PyTorch cache
torch_extensions/

# Results (optional - uncomment if you don't want to track results)
# results/*
# artifacts/metrics/*.csv
# artifacts/figs/*.png

# Notebook outputs (optional - uncomment to ignore all notebook outputs)
# *.ipynb

# Specific large folders
notebooks/triton/
notebooks/notebooks/notebooks/

# Test outputs
test_outputs/
quick_test_checkpoints/

